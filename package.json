    "test:watch": "vitest",
    "build": "node scripts/build.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "ramda": "^0.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.4.0",
    "@types/ramda": "^0.32.0",
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
