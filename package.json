{
  "name": "@alexkorban/html-bookshelf",
  "version": "0.2.1",
  "description": "Render responsive HTML and CSS bookshelves from book collections.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexkorban/html-bookshelf.git"
  },
  "homepage": "https://github.com/alexkorban/html-bookshelf#readme",
  "keywords": [
    "bookshelf",
    "renderer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "html-bookshelf": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.js",
    "typecheck": "tsc -p jsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ramda": "^0.30.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.4.0",
    "@types/ramda": "^0.32.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
